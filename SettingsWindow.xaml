<Window x:Class="DigitalClock.SettingsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:DigitalClock"
		mc:Ignorable="d"
		Title="Digital Clock Settings" Height="590" Width="900"
		WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
		Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
		Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
		FontSize="12">

	<Window.Resources>
		<!-- Standard dialog styles -->
		<Style TargetType="GroupBox">
			<Setter Property="Margin" Value="0,0,0,8"/>
			<Setter Property="Padding" Value="9,6"/>
		</Style>

		<Style TargetType="CheckBox">
			<Setter Property="Margin" Value="0,4"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<Style TargetType="RadioButton">
			<Setter Property="Margin" Value="0,4"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>

		<Style x:Key="DialogButton" TargetType="Button">
			<Setter Property="MinWidth" Value="90"/>
			<Setter Property="Height" Value="27"/>
			<Setter Property="Padding" Value="12,4"/>
			<Setter Property="Margin" Value="4,0"/>
		</Style>

		<Style x:Key="ActionButton" TargetType="Button">
			<Setter Property="Height" Value="27"/>
			<Setter Property="Padding" Value="10,2"/>
			<Setter Property="Margin" Value="4"/>
		</Style>

		<!-- Sidebar Navigation RadioButton Style -->
		<Style x:Key="NavRadioStyle" TargetType="RadioButton">
			<Setter Property="Height" Value="36"/>
			<Setter Property="Margin" Value="0,2"/>
			<Setter Property="Padding" Value="13,0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="Regular"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
							<ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#15000000"/>
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#250078D4"/>
								<Setter Property="Foreground" Value="#0067C0"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Borderless TabControl Style (hidden tab headers) -->
		<Style x:Key="BorderlessTabControl" TargetType="TabControl">
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TabControl">
						<ContentPresenter ContentSource="SelectedContent"/>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid Margin="9">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Top Header Bar -->
		<DockPanel Grid.Row="0" Margin="4">
			<Image x:Name="ImgHeaderIcon" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
			<StackPanel VerticalAlignment="Center">
				<TextBlock Text="Digital Clock Configuration" FontSize="13" FontWeight="Bold"/>
				<TextBlock Text="Customize display format, appearance, aero glass, and window behavior" FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
			</StackPanel>
		</DockPanel>

		<!-- Main 2-Panel Area -->
		<Grid Grid.Row="1" Margin="0,4,0,4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="171"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- LEFT PANEL: Navigation Sidebar -->
			<Border Grid.Column="0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,1,0" Margin="0,0,4,0" Padding="0,0,4,0">
				<StackPanel>
					<RadioButton x:Name="NavGeneral" Content="🕒  General" GroupName="NavTabs" Style="{StaticResource NavRadioStyle}" IsChecked="True" Click="NavButton_Click"/>
					<RadioButton x:Name="NavAppearance" Content="🎨  Appearance" GroupName="NavTabs" Style="{StaticResource NavRadioStyle}" Click="NavButton_Click"/>
					<RadioButton x:Name="NavBehavior" Content="⚙  Behavior &amp; Size" GroupName="NavTabs" Style="{StaticResource NavRadioStyle}" Click="NavButton_Click"/>
					<RadioButton x:Name="NavReset" Content="↺  Reset" GroupName="NavTabs" Style="{StaticResource NavRadioStyle}" Click="NavButton_Click"/>
					<RadioButton x:Name="NavAbout" Content="ℹ  About" GroupName="NavTabs" Style="{StaticResource NavRadioStyle}" Click="NavButton_Click"/>
				</StackPanel>
			</Border>

			<!-- RIGHT PANEL: Settings Content -->
			<TabControl x:Name="SettingsTabControl" Grid.Column="1" Style="{StaticResource BorderlessTabControl}" SelectedIndex="0" Margin="0,0,0,0">

				<!-- TAB 0: GENERAL -->
				<TabItem Header="General">
					<StackPanel>
						<TextBlock Text="General Settings" FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
						<TextBlock Text="Configure time format, seconds, colon animation, and date display." FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,4"/>

						<GroupBox Header="Time Display">
							<StackPanel Margin="2">
								<CheckBox x:Name="Chk24Hour" Content="Use 24-Hour format (e.g. 14:30 vs 02:30 PM)" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
								<CheckBox x:Name="ChkShowSeconds" Content="Show seconds (e.g. 14:30:45)" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
								<CheckBox x:Name="ChkBlinkColon" Content="Blinking colon separator" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
							</StackPanel>
						</GroupBox>

						<GroupBox Header="Date Display">
							<StackPanel Margin="2">
								<CheckBox x:Name="ChkShowDate" Content="Display date label below time" Checked="OnShowDateToggled" Unchecked="OnShowDateToggled"/>
								<TextBlock Text="Date Format Pattern:" Margin="0,9,0,4" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
								<ComboBox x:Name="CmbDateFormat" Height="26" SelectionChanged="CmbDateFormat_SelectionChanged">
									<ComboBoxItem Content="dddd, dd MMMM yyyy (e.g. Monday, 06 October 2026)"/>
									<ComboBoxItem Content="ddd, MMM dd, yyyy (e.g. Mon, Oct 06, 2026)"/>
									<ComboBoxItem Content="yyyy-MM-dd (ISO Standard: 2026-10-06)"/>
									<ComboBoxItem Content="MM/dd/yyyy (US Standard: 10/06/2026)"/>
									<ComboBoxItem Content="dd/MM/yyyy (UK/EU Standard: 06/10/2026)"/>
								</ComboBox>
							</StackPanel>
						</GroupBox>
					</StackPanel>
				</TabItem>

				<!-- TAB 1: APPEARANCE -->
				<TabItem Header="Appearance">
					<StackPanel>
						<TextBlock Text="Appearance &amp; Effects" FontSize="14" FontWeight="Bold" Margin="0,0,0,0"/>
						<TextBlock Text="Customize backdrop styles, typography, color palette, and drop shadow." FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,4"/>

						<!-- Background Style -->
						<GroupBox Header="Background Style">
							<StackPanel Margin="2">
								<ComboBox x:Name="CmbBackgroundStyle" Height="26" SelectionChanged="OnSettingChanged">
									<ComboBoxItem Content="Transparent (Floating digits directly over desktop)"/>
									<ComboBoxItem Content="Windows Acrylic (Fluent frosted backdrop)"/>
									<ComboBoxItem Content="Dark Frosted Pill (Semi-transparent dark backplate)"/>
									<ComboBoxItem Content="Light Frosted Pill (Semi-transparent light backplate)"/>
								</ComboBox>
							</StackPanel>
						</GroupBox>

						<!-- Color Customization -->
						<GroupBox Header="Text Color">
							<StackPanel Margin="2">
								<RadioButton x:Name="RbColorAccent" Content="Sync with Windows accent color" GroupName="ColorMode" Checked="OnSettingChanged"/>
								<RadioButton x:Name="RbColorCustom" Content="Custom color or preset palette" GroupName="ColorMode" Checked="OnSettingChanged"/>

								<!-- Presets Panel -->
								<StackPanel x:Name="PanelCustomColors" Margin="20,4,0,0">
									<WrapPanel x:Name="WrapPresets" Margin="0,0,0,4"/>

									<DockPanel Margin="0,2,0,0">
										<TextBlock Text="HEX Color:" VerticalAlignment="Center" Width="70" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
										<Border x:Name="ColorPreviewBorder" Width="22" Height="22" CornerRadius="4" BorderBrush="#999" BorderThickness="1" Margin="0,0,9,0" Background="#00E5FF"/>
										<TextBox x:Name="TxtHexColor" Width="90" Height="26" VerticalContentAlignment="Center" Text="#00E5FF" TextChanged="TxtHexColor_TextChanged"/>
									</DockPanel>
								</StackPanel>
							</StackPanel>
						</GroupBox>

						<!-- Typography & Drop Shadow -->
						<GroupBox Header="Typography &amp; Effects">
							<Grid Margin="2">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Margin="0,0,9,0">
									<TextBlock Text="Font Family:" Margin="0,0,0,4" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
									<ComboBox x:Name="CmbFontFamily" Height="26" SelectionChanged="OnSettingChanged"/>
									<CheckBox x:Name="ChkDropShadow" Content="Enable drop shadow (top-left light source)" Checked="OnSettingChanged" Unchecked="OnSettingChanged" Margin="0,13,0,0"/>
								</StackPanel>

								<StackPanel Grid.Column="1">
									<DockPanel Margin="0,0,0,9">
										<TextBlock Text="Text Opacity:"/>
										<TextBlock x:Name="LblOpacity" Text="95%" HorizontalAlignment="Right" FontWeight="SemiBold"/>
									</DockPanel>
									<Slider x:Name="SliderOpacity" Minimum="0.1" Maximum="1.0" SmallChange="0.01" LargeChange="0.1" Value="0.95" ValueChanged="SliderOpacity_ValueChanged" Margin="0,0,0,9"/>
								</StackPanel>
							</Grid>
						</GroupBox>
					</StackPanel>
				</TabItem>

				<!-- TAB 2: BEHAVIOR & SIZE -->
				<TabItem Header="Behavior">
					<StackPanel>
						<TextBlock Text="Window Behavior &amp; Sizing" FontSize="14" FontWeight="Bold" Margin="0,0,0,0"/>
						<TextBlock Text="Manage window mobility, size reset, multi-monitor alignment, and startup." FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,8"/>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<!-- Column 0: Window Behavior & Sizing -->
							<StackPanel Grid.Column="0" Margin="0,0,0,0">
								<GroupBox Header="Window Behavior">
									<StackPanel Margin="4">
										<CheckBox x:Name="ChkAlwaysOnTop" Content="Always on Top (Topmost Window)" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
										<CheckBox x:Name="ChkStartWithWindows" Content="Start automatically with Windows" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
										<CheckBox x:Name="ChkLockPosition" Content="Lock position (disable mouse dragging)" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
										<CheckBox x:Name="ChkClickThrough" Content="Click-Through Mode (clicks pass to desktop)" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
										<CheckBox x:Name="ChkShowTrayIcon" Content="Display notification area (tray) icon" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
									</StackPanel>
								</GroupBox>
							</StackPanel>

							<!-- Column 1: Screen Snap Alignment -->
							<StackPanel Grid.Column="1" Margin="9,0,0,0">
								<GroupBox Header="Window Size &amp; Sizing">
									<StackPanel Margin="4">
										<DockPanel Margin="0,4,0,4">
											<TextBlock Text="Saved Dimensions:" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center"/>
											<TextBlock x:Name="TxtSavedSizeStatus" Text="Default / Missing (Border-to-border fit)" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</DockPanel>
										<TextBlock Text="Freely resize the clock by dragging any edge or corner with your mouse. Clear saved dimensions to reset to dynamic border-to-border fitting." Margin="0,0,0,9" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" FontSize="11"/>
										<Button x:Name="BtnResetWindowSize" Content="↺ Reset Size to Default (Clear Saved Size)" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Padding="10,4" Click="ResetWindowSize_Click"/>
									</StackPanel>
								</GroupBox>

							</StackPanel>

						</Grid>
						<Grid>
							<StackPanel Margin="0,0,0,0">
								<GroupBox Header="Screen Snap Alignment">
									<StackPanel Margin="4">
										<TextBlock Text="Snap the clock to screen positions:" Margin="0,0,0,9" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
										<WrapPanel HorizontalAlignment="Center" Margin="0,2">
											<Button Content="↖ Top-Left" Style="{StaticResource ActionButton}" Width="108" Click="SnapTopLeft_Click"/>
											<Button Content="↑ Top-Center" Style="{StaticResource ActionButton}" Width="108" Click="SnapTopCenter_Click"/>
											<Button Content="↗ Top-Right" Style="{StaticResource ActionButton}" Width="108" Click="SnapTopRight_Click"/>
										</WrapPanel>
										<WrapPanel HorizontalAlignment="Center" Margin="0,4">
											<Button Content="➕ Center Screen" Style="{StaticResource ActionButton}" Width="130" Click="SnapCenter_Click"/>
										</WrapPanel>
										<WrapPanel HorizontalAlignment="Center" Margin="0,2">
											<Button Content="↙ Bottom-Left" Style="{StaticResource ActionButton}" Width="108" Click="SnapBottomLeft_Click"/>
											<Button Content="↓ Bottom-Center" Style="{StaticResource ActionButton}" Width="108" Click="SnapBottomCenter_Click"/>
											<Button Content="↘ Bottom-Right" Style="{StaticResource ActionButton}" Width="108" Click="SnapBottomRight_Click"/>
										</WrapPanel>
									</StackPanel>
								</GroupBox>

							</StackPanel>
						</Grid>
					</StackPanel>
				</TabItem>

				<!-- TAB 3: RESET -->
				<TabItem Header="Reset">
					<StackPanel>
						<TextBlock Text="Reset &amp; Storage" FontSize="14" FontWeight="Bold" Margin="0,0,0,0"/>
						<TextBlock Text="Manage configuration storage, restore specific settings categories, or perform a full factory reset." FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,9"/>

						<!-- Configuration Storage -->
						<GroupBox Header="Configuration &amp; Storage">
							<StackPanel Margin="4">
								<DockPanel Margin="0,2,0,4">
									<TextBlock Text="Storage Mode:" FontWeight="SemiBold" VerticalAlignment="Center" Width="140"/>
									<TextBlock x:Name="TxtStorageMode" Text="Portable Mode" FontWeight="SemiBold" Foreground="#007A3D" VerticalAlignment="Center"/>
								</DockPanel>

								<TextBlock Text="Configuration File Path:" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,4,0,4"/>
								<DockPanel Margin="0,0,0,2">
									<Button Content="📂 Open Folder" Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" Click="OpenConfigFolder_Click"/>
									<Button Content="💾 Backup Settings..." Style="{StaticResource ActionButton}" DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" Click="BackupSettings_Click"/>
									<TextBox x:Name="TxtConfigPath" IsReadOnly="True" Height="26" VerticalContentAlignment="Center"/>
								</DockPanel>
							</StackPanel>
						</GroupBox>

						<!-- Granular Reset Options -->
						<GroupBox Header="Granular Reset Options">
							<Grid Margin="4">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="200"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<!-- Appearance Reset -->
								<Button Grid.Row="0" Grid.Column="0" Content="↺ Reset Appearance" Style="{StaticResource ActionButton}" Margin="0,3,8,3" HorizontalAlignment="Stretch" Click="ResetAppearance_Click"/>
								<TextBlock Grid.Row="0" Grid.Column="1" Text="Restores default background style, font, colors, opacity, and drop shadow." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center" Margin="0,3"/>

								<!-- Window Size & Position Reset -->
								<Button Grid.Row="1" Grid.Column="0" Content="↺ Reset Size &amp; Position" Style="{StaticResource ActionButton}" Margin="0,3,8,3" HorizontalAlignment="Stretch" Click="ResetSizeAndPosition_Click"/>
								<TextBlock Grid.Row="1" Grid.Column="1" Text="Clears saved dimensions and returns clock to screen border fitting." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center" Margin="0,3"/>

								<!-- General & Time Reset -->
								<Button Grid.Row="2" Grid.Column="0" Content="↺ Reset Time &amp; Date" Style="{StaticResource ActionButton}" Margin="0,3,8,3" HorizontalAlignment="Stretch" Click="ResetGeneral_Click"/>
								<TextBlock Grid.Row="2" Grid.Column="1" Text="Restores default 24-hr format, seconds display, blinking colon, and date format." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" VerticalAlignment="Center" Margin="0,3"/>
							</Grid>
						</GroupBox>

						<!-- Factory Reset -->
						<GroupBox Header="Factory Reset">
							<StackPanel Margin="4">
								<TextBlock Text="Restore all appearance, time formats, behavior, and window placements back to original factory defaults:" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,9"/>
								<Button Content="⚠️ Reset All Settings to Default" Style="{StaticResource ActionButton}" Width="220" HorizontalAlignment="Left" Click="ResetSettings_Click"/>
							</StackPanel>
						</GroupBox>
					</StackPanel>
				</TabItem>

				<!-- TAB 4: ABOUT -->
				<TabItem Header="About">
					<StackPanel>
						<TextBlock Text="About Digital Clock" FontSize="14" FontWeight="Bold" Margin="0,0,0,0"/>
						<TextBlock Text="Application information, version, and open source repository." FontSize="12" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,0,0,9"/>

						<!-- Application Information -->
						<GroupBox Header="Application Information">
							<StackPanel Margin="4">
								<DockPanel Margin="0,4,0,8">
									<Image x:Name="ImgAboutIcon" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center"/>
									<StackPanel VerticalAlignment="Center">
										<TextBlock x:Name="TxtAppTitle" Text="Digital Clock v2.6" FontWeight="Bold" FontSize="15"/>
										<TextBlock Text="A lightweight, modern desktop clock built with .NET 10 &amp; WPF." Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Margin="0,2,0,0"/>
									</StackPanel>
								</DockPanel>

								<Separator Margin="0,4,0,8"/>

								<Grid Margin="0,2">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="130"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<TextBlock Grid.Row="0" Grid.Column="0" Text="Developer:" FontWeight="SemiBold" Margin="0,2"/>
									<TextBlock Grid.Row="0" Grid.Column="1" Text="Bimal" Margin="0,2"/>

									<TextBlock Grid.Row="1" Grid.Column="0" Text="License:" FontWeight="SemiBold" Margin="0,2"/>
									<TextBlock Grid.Row="1" Grid.Column="1" Text="MIT License" Margin="0,2"/>

									<TextBlock Grid.Row="2" Grid.Column="0" Text="Target Platform:" FontWeight="SemiBold" Margin="0,2"/>
									<TextBlock Grid.Row="2" Grid.Column="1" Text=".NET 10.0 Windows (WPF)" Margin="0,2"/>
								</Grid>
							</StackPanel>
						</GroupBox>

						<!-- Project & Source Code -->
						<GroupBox Header="Project &amp; Source Code">
							<StackPanel Margin="4">
								<TextBlock Text="Digital Clock is free and open-source software. You can view the source code, check for updates, or report issues on GitHub:" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap" Margin="0,0,0,9"/>

								<Button x:Name="BtnGitHub" Style="{StaticResource ActionButton}" Padding="14,4" Height="32" HorizontalAlignment="Left" Click="BtnGitHub_Click">
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
										<Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,8,0"
											  Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57 A 12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z" />
										<TextBlock Text="View on GitHub (Only-Bimal/DigitalClock)" VerticalAlignment="Center" FontWeight="SemiBold"/>
									</StackPanel>
								</Button>
							</StackPanel>
						</GroupBox>
					</StackPanel>
				</TabItem>
			</TabControl>
		</Grid>

		<!-- Bottom Dialog Action Buttons -->
		<DockPanel Grid.Row="2" Margin="0,9,0,0" LastChildFill="False">
			<Button Content="❌ Cancel" Style="{StaticResource DialogButton}" DockPanel.Dock="Right" Click="Cancel_Click"/>
			<Button Content="💾 Save &amp; Close" Style="{StaticResource DialogButton}" DockPanel.Dock="Right" Click="Save_Click"/>
		</DockPanel>
	</Grid>
</Window>
