<Window x:Class="DigitalClock.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		Title="Digital Clock"
		Background="Transparent"
		AllowsTransparency="True"
		WindowStyle="None"
		SizeToContent="Manual"
		ResizeMode="CanResize"
		MinWidth="200"
		MinHeight="80"
		Width="774"
		Height="225"
		IsTabStop="False"
		Loaded="Window_Loaded"
		Closing="Window_Closing" ShowInTaskbar="False">

	<Window.ContextMenu>
		<ContextMenu x:Name="WindowContextMenu">
			<MenuItem Header="⚙ Settings..." Click="OpenSettings_Click" FontWeight="Bold"/>
			<Separator />
			<MenuItem x:Name="MenuAlwaysOnTop" Header="📌 Always on Top" IsCheckable="True" Click="MenuAlwaysOnTop_Click"/>
			<MenuItem x:Name="MenuLockPosition" Header="🔒 Lock Position" IsCheckable="True" Click="MenuLockPosition_Click"/>
			<MenuItem x:Name="MenuClickThrough" Header="👻 Click-Through Mode" IsCheckable="True" Click="MenuClickThrough_Click"/>
			<Separator />
			<MenuItem Header="🖥 Position &amp; Snap">
				<MenuItem Header="🎯 Snap to Primary Screen" Click="MenuSnapPrimary_Click"/>
				<Separator />
				<MenuItem Header="↺ Reset Size to Screen Border" Click="MenuResetSize_Click"/>
				<Separator />
				<MenuItem Header="✛ Center Screen" Click="MenuSnapCenter_Click"/>
				<MenuItem Header="↗ Snap Top-Right" Click="MenuSnapTopRight_Click"/>
				<MenuItem Header="↘ Snap Bottom-Right" Click="MenuSnapBottomRight_Click"/>
				<MenuItem Header="↖ Snap Top-Left" Click="MenuSnapTopLeft_Click"/>
				<MenuItem Header="↙ Snap Bottom-Left" Click="MenuSnapBottomLeft_Click"/>
			</MenuItem>
			<MenuItem x:Name="MenuStartWithWindows" Header="🚀 Start with Windows" IsCheckable="True" Click="MenuStartWithWindows_Click"/>
			<Separator />
			<MenuItem Header="❌ Close DigitalClock" Click="MenuClose_Click"/>
		</ContextMenu>
	</Window.ContextMenu>

	<Grid x:Name="RootGrid" Background="#01000000"
		  PreviewMouseLeftButtonDown="RootGrid_PreviewMouseLeftButtonDown"
		  PreviewMouseMove="RootGrid_PreviewMouseMove"
		  PreviewMouseLeftButtonUp="RootGrid_PreviewMouseLeftButtonUp"
		  MouseLeave="RootGrid_MouseLeave"
		  MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">

		<!-- Clock Container / Backplate: fills the window entirely with Margin="0" -->
		<Border x:Name="BackplateBorder"
				CornerRadius="18"
				Padding="4,4,4,4"
				Margin="0">
			<!-- Unified scaling Viewbox: fills the container and scales the clock lockup cleanly -->
			<Viewbox x:Name="ClockViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel x:Name="ClockContainer" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
					<!-- Time TextBlock with tight block line height to eliminate excess font ascent/descent leading -->
					<TextBlock x:Name="ClockTimes"
							   Text="00:00"
							   FontWeight="Bold"
							   FontSize="100"
							   LineHeight="90"
							   Margin="0,2,0,0"
							   HorizontalAlignment="Center"
							   TextAlignment="Center"
							   Typography.NumeralAlignment="Tabular" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center">
						<TextBlock.Effect>
							<DropShadowEffect x:Name="TimeShadowEffect" BlurRadius="9" ShadowDepth="4" Direction="315" Color="#000000" Opacity="0.70"/>
						</TextBlock.Effect>
					</TextBlock>

					<!-- Date TextBlock with snug spacing locked under time -->
					<TextBlock x:Name="ClockDates"
							   Text="Wednesday, 00 September 0000"
							   FontWeight="SemiBold"
							   FontSize="36"
							   LineStackingStrategy="BlockLineHeight"
							   LineHeight="32"
							   Margin="0,2,0,0"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   TextAlignment="Center">
						<TextBlock.Effect>
							<DropShadowEffect x:Name="DateShadowEffect" BlurRadius="9" ShadowDepth="4" Direction="315" Color="#000000" Opacity="0.70"/>
						</TextBlock.Effect>
					</TextBlock>
				</StackPanel>
			</Viewbox>
		</Border>

		<!-- Subtle corner resize indicator -->
		<Canvas IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Margin="0,0,3,3" Opacity="0.40">
			<Line X1="14" Y1="4" X2="4" Y2="14" Stroke="{Binding Foreground, ElementName=ClockTimes}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
			<Line X1="14" Y1="8" X2="8" Y2="14" Stroke="{Binding Foreground, ElementName=ClockTimes}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
			<Line X1="14" Y1="12" X2="12" Y2="14" Stroke="{Binding Foreground, ElementName=ClockTimes}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
		</Canvas>
	</Grid>
</Window>
